/backend/Homestead.json
/backend/Homestead.yaml
/backend/auth.json

# --- Frontend (Vite/React) ---
/frontend/node_modules
/frontend/dist
/frontend/dist-ssr
/frontend/.env
/frontend/.env.local
/frontend/.env.*.local
/frontend/coverage
*.local

